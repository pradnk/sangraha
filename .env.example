# Copy to .env and adjust. Defaults match infra/docker-compose.yml.

# ---- Database -------------------------------------------------------------
# Owner role. Runs migrations and DDL (including analytics view generation).
DATABASE_URL=postgres://mis:mis_dev_password@localhost:5432/mis

# Application role. Non-superuser so Row-Level Security is actually enforced
# on it — the owner role bypasses RLS, which is why these are separate.
# Created by the first migration, using the password in this URL.
DATABASE_APP_URL=postgres://mis_app:mis_app_dev_password@localhost:5432/mis

# Connection behaviour is detected: one connection per instance on Vercel, ten on
# a long-lived production server, four in development — every Next process opens
# two pools (app role and owner role), so a bigger development default exhausts
# Postgres's hundred as soon as you run a second dev server. Behind a transaction
# pooler (Neon "-pooler", Supabase :6543, pgbouncer=true) prepared statements are
# disabled. Override only if needed.
# DATABASE_POOL_MAX=10
# DATABASE_POOLED=true

# Set to 1 to keep migrations out of the deployment build.
# SKIP_MIGRATIONS=1

# ---- Auth -----------------------------------------------------------------
# Generate with: openssl rand -base64 32
#
# Left empty on purpose. This used to ship a 39-character placeholder, which
# satisfied the length check — so an installation that never replaced it ran
# happily, signing its session cookies with a string published in this
# repository. Empty fails immediately and says what to do; a placeholder that
# works is worse than one that does not.
AUTH_SECRET=
AUTH_URL=http://localhost:3000
# Field workers should not be re-authenticating mid-village. 30 days.
SESSION_MAX_AGE_DAYS=30
# PIN lockout policy
PIN_MAX_ATTEMPTS=5
PIN_LOCKOUT_MINUTES=15

# ---- Object storage (S3-compatible) ---------------------------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mis-attachments
S3_ACCESS_KEY_ID=mis
S3_SECRET_ACCESS_KEY=mis_dev_password
# MinIO needs path-style; R2/S3 do not.
S3_FORCE_PATH_STYLE=true

# ---- Signup ---------------------------------------------------------------
# Who may create an organisation at /start.
#   open    anyone with the URL. Fine for a trial or an internal network.
#   code    a shared code is required (set SIGNUP_CODE).
#   closed  no signup; use `npm run org:create`.
# Defaults to "open" in development and "closed" in production. Closed still
# allows the FIRST organisation to be created, so a fresh deployment can be set
# up from /start with no shell access; it closes once one exists.
# SIGNUP_MODE=closed
# Setting a code implies SIGNUP_MODE=code. Setting the mode to "code" without
# filling this in closes signup and logs why — an empty code is not a gate.
# SIGNUP_CODE=

# ---- Translation (optional) -----------------------------------------------
# Enables the "Translate" button in the form builder, which fills in missing
# translations of an organisation's own questions. Without it the button is
# hidden and translations are typed by hand.
# Enable "Cloud Translation API" in Google Cloud first, then pick ONE of the
# two credentials below. Restart the app after setting it — .env is read at
# startup. Billed per character; only form questions and hints are sent, never
# collected data.
#
# EITHER (simplest) an API key — a plain string, no file:
#   APIs & Services > Credentials > Create credentials > API key
#   Restrict it to the Cloud Translation API.
# GOOGLE_TRANSLATE_API_KEY=AIza...
#
# OR a service account, if that is what you were given a JSON file for.
# Do NOT paste the JSON here — point at the file:
#   APIs & Services > Credentials > Create credentials > Service account
#   then Keys > Add key > JSON, and grant it "Cloud Translation API User".
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/path/to/key.json
#
# For a host with no filesystem (Vercel, Fly), pass the same JSON base64-encoded:
#   base64 -i key.json | pbcopy
# GOOGLE_TRANSLATE_CREDENTIALS=eyJ0eXBlIjoic2Vydmlj...
#
# Optional: point at a proxy or an API-compatible service.
# GOOGLE_TRANSLATE_ENDPOINT=

# ---- App ------------------------------------------------------------------
NODE_ENV=development
DEFAULT_LOCALE=en
